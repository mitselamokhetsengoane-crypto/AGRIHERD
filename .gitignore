# ============================================================
# AGRIHERD ROOT .GITIGNORE
# ============================================================

# ====================
# 1. SECRETS & ENV
# ====================
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local

# ====================
# 2. NODE.JS (Frontend & Blockchain)
# ====================
node_modules/
frontend/node_modules/
blockchain/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
dist-ssr/
frontend/dist/
build/
frontend/build/

# ====================
# 3. PYTHON (Backend & AI)
# ====================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
backend/.venv/
ai-model/venv/
*.egg-info/
.installed.cfg
*.egg

# ====================
# 4. AI MODEL DATA (but NOT the .pt file)
# ====================
# We keep best.pt so Render can use the AI model
ai-model/datasets/
ai-model/predictions/
runs/
*.cache

# ====================
# 5. BLOCKCHAIN (Hardhat)
# ====================
blockchain/artifacts/
blockchain/cache/
blockchain/typechain-types/
blockchain/coverage/
blockchain/coverage.json

# ====================
# 6. DATABASE & EXCEL FILES
# ====================
*.sqlite
*.db
*.xlsx
security/data_classification/*.xlsx
security/permissions/*.xlsx
security/gdpr/*.xlsx

# ====================
# 7. OPERATING SYSTEM & IDE
# ====================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
# Exclude large blockchain archive
/blockchain.zip
